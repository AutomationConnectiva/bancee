NEXT_PUBLIC_SITE_URL=https://www.bancee.eu
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key

# Preferred Connectiva OS handoff. When configured, validated website submissions
# are passed to Make, which can coordinate Supabase/Airtable/Zoho Mail workflows.
MAKE_ATTENDANCE_WEBHOOK_URL=
MAKE_REGISTRATION_WEBHOOK_URL=
MAKE_PARTNERSHIP_WEBHOOK_URL=
MAKE_SPEAKER_WEBHOOK_URL=

# Legacy fallback settings retained for the current Namecheap build.
APPROVAL_SECRET=replace_with_strong_secret
APPROVER_EMAIL=mohamad@connectiva.events
EMAIL_FROM=Banking CEE Network <info@bancee.eu>

# Server-only key used for secure attendee headshot uploads. Never expose this as NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
REGISTRATION_PHOTO_BUCKET=registration-headshots
NEWSLETTER_TABLE=newsletter_signups
MAKE_NEWSLETTER_WEBHOOK_URL=
